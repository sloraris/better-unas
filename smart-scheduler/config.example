# smart-scheduler settings. Every line is optional; an empty file uses the
# defaults shown here. Changes take effect on the next hourly run.
# Check your edits with:  python3 smart_scheduler.py status

# "no" stops new tests and the next run removes the hourly timer; running
# tests finish. Changing Enabled in Settings does this when you save. After a
# hand edit back to "yes", run install.sh to put the timer back.
ENABLED=yes

# UniFi OS account the tests run as. Empty = the console owner, which needs no
# setup. To use another account, give its username; it must be an admin with
# UniFi Drive management rights (Drive rejects everyone else with 403).
DRIVE_USER=

# --- How often each drive gets an extended test ------------------------------
# Healthy drive.
INTERVAL_DAYS=90
# Drive showing warning signs: any WARN_ATTRIBUTES above zero, a UniFi risk
# reason, or a UniFi state other than optimal.
WARN_INTERVAL_DAYS=30
# Drive older than OLD_DRIVE_HOURS of power-on time (43800 h is about 5 years).
OLD_INTERVAL_DAYS=60
OLD_DRIVE_HOURS=43800
# After a test fails or is aborted, try again this many days later (and alert).
RETRY_FAILED_DAYS=7
# SMART attributes that count as warning signs. If one rises since the last
# test, that drive is tested on the next eligible night.
# 5 reallocated, 187 reported uncorrectable, 197 pending, 198 offline uncorrectable
WARN_ATTRIBUTES=5,187,197,198

# Per-drive intervals, by serial number:  SERIAL:DAYS,SERIAL:DAYS
INTERVAL_OVERRIDES=
# Drives to never test, by serial number, comma-separated.
EXCLUDE_SERIALS=

# --- When tests may start ------------------------------------------------------
# Local time (the NAS's timezone). May cross midnight, e.g. 22:00-04:00.
START_WINDOW=00:00-05:00
# Never run more than this many tests at once, or start more per night.
# MAX_STARTS_PER_NIGHT=0 pauses new tests (everything else keeps running).
MAX_CONCURRENT=1
MAX_STARTS_PER_NIGHT=1
# Don't start a test that could still be running this many hours before a
# scheduled scrub. A test's length is the drive's own estimate x DURATION_FACTOR.
SCRUB_MARGIN_HOURS=2
DURATION_FACTOR=1.5
# Skip a drive that is busier than this (read + write, KB/s) when the test
# would start. 0 turns the check off.
BUSY_KBPS=20000

# --- UniFi backups and replication ---------------------------------------------
# Keep tests clear of UniFi Drive's scheduled backup and replication tasks
# (UniFi Cloud backups, UNAS-to-UNAS, local copies), read from Drive's own
# task list. Only the schedules and run times are read, never credentials.
BACKUP_AVOID=yes
# Don't start a test that could still be running this many hours before a
# task starts, or until this many hours after its estimated end.
BACKUP_MARGIN_HOURS=1
# How long a task with no run history is assumed to take, in hours.
BACKUP_DEFAULT_HOURS=4
# Upload speed to the backup provider in Mbit/s, used with no run history when
# the task has no bandwidth limit. 0 = unknown (BACKUP_DEFAULT_HOURS applies).
BACKUP_UPLOAD_MBPS=0

# Notifications (webhook, heartbeat, alert repeat) are shared by every tool:
# set them in Settings › Notifications, saved in better-unas.conf next to this
# folder. WEBHOOK_URL and the other notification keys set here are still read
# when better-unas.conf doesn't set them.
